# === Client-side (브라우저에 노출) ===
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# === Sentry (에러 트래킹) ===
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# === Server-only (절대 브라우저에 노출 금지) ===
SUPABASE_SERVICE_ROLE_KEY=

# === Upstash Redis (캐싱) ===
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# === Storage ===
STORAGE_LIMIT_BYTES=1073741824  # 1 GB (기본값)

# === Webhook (연동) ===
WEBHOOK_DISPATCH_SECRET=

# === Integration Encryption (연동 토큰 암호화) ===
# 32바이트 (64 hex chars) AES-256-GCM 키: openssl rand -hex 32
INTEGRATION_ENCRYPTION_KEY=

# === Maintenance Mode (점검 모드) ===
# 'true' = 점검 모드 활성화 (재배포 없이 환경변수 변경만으로 on/off)
MAINTENANCE_MODE=true
# 관리자 우회 비밀키:
# 관리자가 URL에 비밀키를 붙여서 접속: https://mysite.com/?bypass=my-secret-123
MAINTENANCE_BYPASS_KEY=my-secret-123
# (선택) 점검 안내 메시지
MAINTENANCE_MESSAGE=점검 안내 메시지
# (선택) 예상 복구 시간 (ISO 8601 또는 평문) 예) 2026-02-14T06:00:00+09:00 또는 "오후 6시 예정"
MAINTENANCE_UNTIL=오후 6시 예정
