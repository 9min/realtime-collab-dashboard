# === Client-side (브라우저에 노출) ===
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# === Sentry (에러 트래킹) ===
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# === Server-only (절대 브라우저에 노출 금지) ===
SUPABASE_SERVICE_ROLE_KEY=

# === Upstash Redis (캐싱) ===
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# === Storage ===
STORAGE_LIMIT_BYTES=1073741824  # 1 GB (기본값)

# === Webhook (연동) ===
WEBHOOK_DISPATCH_SECRET=

# === Integration Encryption (연동 토큰 암호화) ===
# 32바이트 (64 hex chars) AES-256-GCM 키: openssl rand -hex 32
INTEGRATION_ENCRYPTION_KEY=

# === Maintenance Mode (점검 모드) ===
# 관리자 우회 비밀키 (https://mysite.com/?bypass=<키>로 접속)
# 점검 설정은 프로젝트 루트의 maintenance.json에서 관리
MAINTENANCE_BYPASS_KEY=
